<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ElectVote — General Election 2025</title>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: #f8f7f4;
      color: #1a1a18;
      min-height: 100vh;
    }

    /* ── top banner ── */
    .top-banner {
      background: #1a1a18;
      color: #f8f7f4;
      text-align: center;
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: 8px 20px;
    }

    header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 40px;
      border-bottom: 1px solid #e5e2da;
      background: #f8f7f4;
    }

    .logo {
      font-family: 'Instrument Serif', serif;
      font-size: 1.35rem; color: #1a1a18;
    }

    .live-pill {
      display: flex; align-items: center; gap: 6px;
      background: #eeeae0; border-radius: 20px;
      padding: 5px 14px; font-size: .7rem;
      font-weight: 500; color: #5a5748;
      letter-spacing: .07em; text-transform: uppercase;
    }

    .dot { width: 6px; height: 6px; border-radius: 50%; background: #b84040; animation: blink 1.6s infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }

    main { max-width: 740px; margin: 0 auto; padding: 56px 24px 80px; }

    .page-title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(2rem, 5vw, 2.9rem);
      font-weight: 400; line-height: 1.15;
      letter-spacing: -.03em; margin-bottom: 6px;
    }

    .page-sub { font-size: .9rem; color: #847e70; margin-bottom: 14px; font-weight: 300; }

    .election-date {
      display: inline-flex; align-items: center; gap: 8px;
      background: #fff; border: 1px solid #e5e2da;
      border-radius: 8px; padding: 7px 14px;
      font-size: .78rem; color: #5a5748; margin-bottom: 48px;
    }

    .cal-icon {
      width: 14px; height: 14px;
      border: 1.5px solid #b0a898; border-radius: 3px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 8px; font-weight: 500; color: #b84040;
    }

    /* ── stats ── */
    .stats { display: flex; gap: 14px; margin-bottom: 48px; }

    .stat {
      background: #fff; border: 1px solid #e5e2da;
      border-radius: 12px; padding: 18px 20px; flex: 1;
    }

    .stat-n {
      font-family: 'Instrument Serif', serif;
      font-size: 1.9rem; color: #1a1a18; line-height: 1;
    }

    .stat-l { font-size: .68rem; color: #b0a898; text-transform: uppercase; letter-spacing: .08em; margin-top: 4px; }

    /* ── section heading ── */
    .section-head {
      display: flex; align-items: baseline; justify-content: space-between;
      margin-bottom: 14px;
    }

    .section-title {
      font-family: 'Instrument Serif', serif;
      font-size: 1.05rem; color: #1a1a18;
    }

    .vote-count-label { font-size: .75rem; color: #b0a898; }

    /* ── poll card ── */
    .poll {
      background: #fff; border: 1px solid #e5e2da;
      border-radius: 16px; padding: 30px;
      margin-bottom: 20px;
    }

    .poll-tag {
      font-size: .67rem; font-weight: 500; text-transform: uppercase;
      letter-spacing: .1em; color: #b84040; margin-bottom: 10px;
      display: inline-block;
    }

    .poll-q {
      font-family: 'Instrument Serif', serif;
      font-size: 1.2rem; font-weight: 400;
      line-height: 1.4; margin-bottom: 24px; color: #1a1a18;
    }

    .options { display: flex; flex-direction: column; gap: 10px; }

    /* ── candidate option ── */
    .option {
      position: relative; cursor: pointer;
      border: 1px solid #e5e2da; border-radius: 11px;
      overflow: hidden; background: #f8f7f4;
      transition: border-color .18s;
    }

    .option:hover { border-color: #b0a898; }
    .option input[type="radio"] { display: none; }

    .bar {
      position: absolute; left: 0; top: 0; bottom: 0; width: 0;
      border-radius: 10px;
      transition: width .95s cubic-bezier(.4,0,.2,1);
      pointer-events: none;
    }

    /* party colors — bars */
    .party-blue .bar  { background: #dce8f7; }
    .party-red .bar   { background: #f7dcdc; }
    .party-green .bar { background: #ddf0e2; }
    .party-amber .bar { background: #faecd6; }

    /* party accent colors */
    .party-blue  { --pc: #2563b0; --pc-light: #dce8f7; }
    .party-red   { --pc: #b82525; --pc-light: #f7dcdc; }
    .party-green { --pc: #1e8040; --pc-light: #ddf0e2; }
    .party-amber { --pc: #b86a10; --pc-light: #faecd6; }

    .opt-inner {
      position: relative; z-index: 2;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px; gap: 12px;
    }

    .opt-left { display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0; }

    /* party color swatch */
    .swatch {
      width: 10px; height: 36px; border-radius: 4px;
      background: var(--pc); flex-shrink: 0;
    }

    .candidate-info { flex: 1; min-width: 0; }

    .candidate-name {
      font-family: 'Instrument Serif', serif;
      font-size: 1rem; color: #1a1a18; line-height: 1.2;
    }

    .candidate-party {
      font-size: .72rem; color: #847e70; margin-top: 2px;
    }

    .circle {
      width: 18px; height: 18px; border-radius: 50%;
      border: 1.5px solid #c9c3b7; flex-shrink: 0;
      background: #fff;
      display: flex; align-items: center; justify-content: center;
      transition: border-color .15s, background .15s;
    }

    .circle::after {
      content: ''; width: 7px; height: 7px; border-radius: 50%;
      background: #fff; opacity: 0; transition: opacity .15s;
    }

    .opt-pct {
      font-size: .82rem; font-weight: 500;
      color: #b0a898; opacity: 0;
      transition: opacity .35s .3s; min-width: 36px; text-align: right;
    }

    .option.selected { border-color: var(--pc); }
    .option.selected .circle { border-color: var(--pc); background: var(--pc); }
    .option.selected .circle::after { opacity: 1; }
    .option.voted .opt-pct { opacity: 1; color: var(--pc); }

    /* ── vote button ── */
    .vote-btn {
      width: 100%; margin-top: 18px; padding: 13px;
      border: 1.5px solid #1a1a18; border-radius: 10px;
      background: transparent; color: #1a1a18;
      font-family: 'DM Sans', sans-serif;
      font-size: .87rem; font-weight: 500; letter-spacing: .04em;
      cursor: pointer;
      transition: background .15s, color .15s, opacity .15s;
    }

    .vote-btn:hover:not(:disabled) { background: #1a1a18; color: #f8f7f4; }
    .vote-btn:disabled { opacity: .28; cursor: not-allowed; }
    .vote-btn.done { background: #eeeae0; color: #5a5748; border-color: #e5e2da; pointer-events: none; }

    .thanks {
      display: none; text-align: center;
      font-size: .85rem; color: #b0a898;
      padding-top: 12px; font-style: italic;
      font-family: 'Instrument Serif', serif;
    }
    .thanks.show { display: block; }

    /* ── disclaimer ── */
    .disclaimer {
      margin-top: 40px;
      border-top: 1px solid #e5e2da; padding-top: 20px;
      font-size: .75rem; color: #b0a898; line-height: 1.7;
      text-align: center;
    }

    footer {
      text-align: center; padding: 24px;
      border-top: 1px solid #e5e2da;
      font-size: .73rem; color: #b0a898;
    }

    @media (max-width: 540px) {
      header { padding: 16px 20px; }
      main { padding: 36px 16px 60px; }
      .poll { padding: 22px 16px; }
      .stats { flex-wrap: wrap; gap: 10px; }
      .stat { min-width: calc(50% - 5px); flex: none; }
    }
  </style>
</head>
<body>

<div class="top-banner">Official Sample Ballot &mdash; General Election 2025</div>

<header>
  <div class="logo">ElectVote</div>
  <div class="live-pill"><span class="dot"></span> Voting Open</div>
</header>

<main>
  <h1 class="page-title">General Election<br><em>2025 Ballot</em></h1>
  <p class="page-sub">Cast your vote for each race below. Your selection is final once submitted.</p>

  <div class="election-date">
    <span class="cal-icon">25</span>
    Election Day &mdash; November 25, 2025 &nbsp;&bull;&nbsp; Polls close at 8:00 PM
  </div>

  <!-- Stats -->
  <div class="stats">
    <div class="stat">
      <div class="stat-n" id="totalVotes">0</div>
      <div class="stat-l">Votes cast</div>
    </div>
    <div class="stat">
      <div class="stat-n">3</div>
      <div class="stat-l">Races</div>
    </div>
    <div class="stat">
      <div class="stat-n" id="participants">0</div>
      <div class="stat-l">Voters</div>
    </div>
    <div class="stat">
      <div class="stat-n" id="completed">0/3</div>
      <div class="stat-l">Completed</div>
    </div>
  </div>

  <!-- Race 1: President -->
  <div class="section-head">
    <span class="section-title">Race 1 of 3</span>
    <span class="vote-count-label" id="r1-total">0 votes</span>
  </div>

  <div class="poll">
    <span class="poll-tag">Presidential Race</span>
    <div class="poll-q">Who do you cast your vote for as President of the Republic?</div>
    <div class="options">

      <label class="option party-blue" id="r1-a">
        <input type="radio" name="race1" value="a"/>
        <div class="bar" id="br1-a"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">James Hartwell</div>
              <div class="candidate-party">National Democratic Party</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct1-a">0%</span>
        </div>
      </label>

      <label class="option party-red" id="r1-b">
        <input type="radio" name="race1" value="b"/>
        <div class="bar" id="br1-b"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Margaret Cole</div>
              <div class="candidate-party">Conservative Alliance</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct1-b">0%</span>
        </div>
      </label>

      <label class="option party-green" id="r1-c">
        <input type="radio" name="race1" value="c"/>
        <div class="bar" id="br1-c"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Priya Sundaram</div>
              <div class="candidate-party">Green People's Party</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct1-c">0%</span>
        </div>
      </label>

      <label class="option party-amber" id="r1-d">
        <input type="radio" name="race1" value="d"/>
        <div class="bar" id="br1-d"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">David Okonkwo</div>
              <div class="candidate-party">United Liberty Front</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct1-d">0%</span>
        </div>
      </label>

    </div>
    <button class="vote-btn" id="btn1" onclick="castVote('race1','1')" disabled>Select a candidate to vote</button>
    <div class="thanks" id="ty1">Your presidential vote has been recorded.</div>
  </div>

  <!-- Race 2: Senate -->
  <div class="section-head">
    <span class="section-title">Race 2 of 3</span>
    <span class="vote-count-label" id="r2-total">0 votes</span>
  </div>

  <div class="poll">
    <span class="poll-tag">Senate Seat &mdash; District 4</span>
    <div class="poll-q">Who do you choose to represent District 4 in the Senate?</div>
    <div class="options">

      <label class="option party-red" id="r2-a">
        <input type="radio" name="race2" value="a"/>
        <div class="bar" id="br2-a"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Sandra Whitmore</div>
              <div class="candidate-party">Conservative Alliance</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct2-a">0%</span>
        </div>
      </label>

      <label class="option party-blue" id="r2-b">
        <input type="radio" name="race2" value="b"/>
        <div class="bar" id="br2-b"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Carlos Rivera</div>
              <div class="candidate-party">National Democratic Party</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct2-b">0%</span>
        </div>
      </label>

      <label class="option party-amber" id="r2-c">
        <input type="radio" name="race2" value="c"/>
        <div class="bar" id="br2-c"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Fatima Al-Hassan</div>
              <div class="candidate-party">United Liberty Front</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct2-c">0%</span>
        </div>
      </label>

    </div>
    <button class="vote-btn" id="btn2" onclick="castVote('race2','2')" disabled>Select a candidate to vote</button>
    <div class="thanks" id="ty2">Your senate vote has been recorded.</div>
  </div>

  <!-- Race 3: Referendum -->
  <div class="section-head">
    <span class="section-title">Race 3 of 3</span>
    <span class="vote-count-label" id="r3-total">0 votes</span>
  </div>

  <div class="poll">
    <span class="poll-tag">Referendum &mdash; Measure A</span>
    <div class="poll-q">Do you support Measure A: Expanding renewable energy infrastructure with a 2% levy on fossil fuel corporations?</div>
    <div class="options">

      <label class="option party-green" id="r3-a">
        <input type="radio" name="race3" value="a"/>
        <div class="bar" id="br3-a"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Yes — I support Measure A</div>
              <div class="candidate-party">In favour of the proposal</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct3-a">0%</span>
        </div>
      </label>

      <label class="option party-red" id="r3-b">
        <input type="radio" name="race3" value="b"/>
        <div class="bar" id="br3-b"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">No — I oppose Measure A</div>
              <div class="candidate-party">Against the proposal</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct3-b">0%</span>
        </div>
      </label>

      <label class="option party-amber" id="r3-c">
        <input type="radio" name="race3" value="c"/>
        <div class="bar" id="br3-c"></div>
        <div class="opt-inner">
          <div class="opt-left">
            <div class="swatch"></div>
            <div class="candidate-info">
              <div class="candidate-name">Abstain</div>
              <div class="candidate-party">No preference recorded</div>
            </div>
            <div class="circle"></div>
          </div>
          <span class="opt-pct" id="pct3-c">0%</span>
        </div>
      </label>

    </div>
    <button class="vote-btn" id="btn3" onclick="castVote('race3','3')" disabled>Select your position to vote</button>
    <div class="thanks" id="ty3">Your referendum vote has been recorded.</div>
  </div>

  <div class="disclaimer">
    This is a demonstration ballot only. No real votes are collected or stored.<br>
    All candidate names, parties, and measures are entirely fictional.
  </div>
</main>

<footer>ElectVote &mdash; Secure Digital Balloting &copy; 2025</footer>

<script>
  const races = {
    race1: { a:0, b:0, c:0, d:0, voted:false, sel:null, opts:['a','b','c','d'] },
    race2: { a:0, b:0, c:0, voted:false, sel:null, opts:['a','b','c'] },
    race3: { a:0, b:0, c:0, voted:false, sel:null, opts:['a','b','c'] }
  };

  let pCount = 0, completedCount = 0;

  document.querySelectorAll('input[type="radio"]').forEach(r => {
    r.addEventListener('change', function() {
      const rid = this.name, val = this.value;
      const n = rid.replace('race','');
      races[rid].sel = val;
      races[rid].opts.forEach(k => document.getElementById('r'+n+'-'+k).classList.remove('selected'));
      document.getElementById('r'+n+'-'+val).classList.add('selected');
      const btn = document.getElementById('btn'+n);
      btn.disabled = false;
      btn.textContent = 'Submit vote \u2192';
    });
  });

  function castVote(rid, n) {
    const s = races[rid];
    if (!s.sel || s.voted) return;
    s[s.sel]++; s.voted = true;
    completedCount++;

    const total = s.opts.reduce((t,k) => t + s[k], 0);
    s.opts.forEach(k => {
      const pct = Math.round((s[k] / total) * 100);
      document.getElementById('pct'+n+'-'+k).textContent = pct + '%';
      document.getElementById('br'+n+'-'+k).style.width = pct + '%';
      const opt = document.getElementById('r'+n+'-'+k);
      opt.classList.add('voted');
      opt.style.pointerEvents = 'none';
    });

    document.getElementById('r'+n+'-total').textContent = total + ' vote' + (total !== 1 ? 's' : '');
    const btn = document.getElementById('btn'+n);
    btn.classList.add('done'); btn.textContent = '\u2713 Vote submitted';
    document.getElementById('ty'+n).classList.add('show');

    // first time voter
    if (completedCount === 1) pCount++;
    document.getElementById('participants').textContent = pCount;

    const allVotes = Object.values(races).reduce((t,r) => t + r.opts.reduce((s,k) => s+r[k], 0), 0);
    document.getElementById('totalVotes').textContent = allVotes;
    document.getElementById('completed').textContent = completedCount + '/3';
  }
</script>
</body>
</html>
